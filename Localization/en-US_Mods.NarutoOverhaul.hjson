	TailedBeastBoss.DisplayName: Shukaku
	HakuBoss.DisplayName: Haku
	OrochimaruBoss.DisplayName: Orochimaru
	KakuzuBoss.DisplayName: Kakuzu
	PainBoss.DisplayName: Pain
	MadaraBoss.DisplayName: Madara
	KaguyaBoss.DisplayName: Kaguya

	ShinobiVendorNPC: {
		DisplayName: Tenten

		TownNPCMood: {
			Content: My tools are all in order. Can't complain.
			NoHome: A shinobi needs a real workshop, not the open road.
			FarFromHome: I'm too far from my tool shop for comfort.
			LoveSpace: Plenty of room to lay out my whole arsenal.
			DislikeCrowded: A bit too crowded to spread my tools out.
			HateCrowded: I can barely swing a kunai in here.
			LikeNPC_Princess: "{NPCName} appreciates good craftsmanship."
			Princess_LovesNPC: "{NPCName} says my tools are the finest around."
		}
	}

	GuySenseiNPC: {
		DisplayName: Might Guy

		TownNPCMood: {
			Content: The flames of youth burn bright today!
			NoHome: Even the flames of youth need a place to rest!
			FarFromHome: Too far from home dims the flames of youth.
			LoveSpace: Plenty of room for youthful training here!
			DislikeCrowded: A little cramped for proper training.
			HateCrowded: No room to unleash the flames of youth in here!
			LikeNPC_Princess: "{NPCName} shares my burning youthful spirit!"
			Princess_LovesNPC: "{NPCName} says my youthful energy is inspiring!"
		}
	}

	ItachiNPC: {
		DisplayName: Itachi Uchiha

		TownNPCMood: {
			Content: Peaceful enough, for now.
			NoHome: A shinobi without shelter is a liability.
			FarFromHome: Too far from where I need to be.
			LoveSpace: Room enough to watch every approach.
			DislikeCrowded: Too many eyes in too little space.
			HateCrowded: Far too crowded to keep watch properly.
			LikeNPC_Princess: "{NPCName} understands the weight I carry."
			Princess_LovesNPC: "{NPCName} trusts me more than most do."
		}
	}

	KakashiNPC: {
		DisplayName: Kakashi Hatake

		TownNPCMood: {
			Content: Just another page in my book, really.
			NoHome: Even I need somewhere to read in peace.
			FarFromHome: A bit far from home for my taste.
			LoveSpace: Plenty of room to copy a jutsu or two.
			DislikeCrowded: A little too crowded to concentrate.
			HateCrowded: Can't even open my book in this crowd.
			LikeNPC_Princess: "{NPCName} is surprisingly good company."
			Princess_LovesNPC: "{NPCName} says I'm always fashionably late."
		}
	}
}

