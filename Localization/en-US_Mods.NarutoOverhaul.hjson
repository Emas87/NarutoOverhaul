Keybinds: {
	"Toggle Sage Mode.DisplayName": Toggle Sage Mode
	"Toggle Tailed Beast Mode.DisplayName": Toggle Tailed Beast Mode
	"Toggle Six Paths Sage Mode.DisplayName": Toggle Six Paths Sage Mode
	"Toggle Eight Gates.DisplayName": Toggle Eight Gates
	"Toggle Chakra Control.DisplayName": Toggle Chakra Control
}

Buffs: {
	SageModeBuff: {
		DisplayName: Sage Mode
		Description: Drawing on natural energy - boosted damage and movement speed while it lasts
	}

	SharinganFocusBuff: {
		DisplayName: Sharingan Focus
		Description: Your eyes see the attack coming before it lands
	}

	TailedBeastModeBuff: {
		DisplayName: Tailed Beast Mode
		Description: Cloaked in the Tailed Beast's chakra - immense power at a steady cost
	}

	SixPathsSageModeBuff: {
		DisplayName: Six Paths Sage Mode
		Description: The strength of the Sage of the Six Paths flows through you
	}

	EightGatesBuff: {
		DisplayName: Eight Gates
		Description: Each gate opened trades more of your body for more of your power - the eighth gate is fatal
	}

	GenjutsuControlDebuff: {
		DisplayName: Puppeted
		Description: An illusion has seized control of your movement
	}

	GenjutsuFearDebuff: {
		DisplayName: Terrified
		Description: Fleeing in blind panic from an illusion
	}

	GenjutsuSleepDebuff: {
		DisplayName: Genjutsu Slumber
		Description: Trapped in an unbreakable dream
	}

	NinjaHoundMinionBuff: {
		DisplayName: Ninja Hound
		Description: A summoned ninja hound is fighting for you
	}

	SlugMinionBuff: {
		DisplayName: Slug Summon
		Description: A summoned slug is fighting for you
	}

	SnakeMinionBuff: {
		DisplayName: Snake Summon
		Description: A summoned snake is fighting for you
	}

	ToadMinionBuff: {
		DisplayName: Toad Summon
		Description: A summoned toad is fighting for you
	}

	ChakraRegenBuff: {
		DisplayName: Chakra Focus
		Description: Chakra regenerates faster than usual
	}

	StaminaRegenBuff: {
		DisplayName: Second Wind
		Description: Stamina regenerates faster than usual
	}

	ChakraControlBuff: {
		DisplayName: Chakra Control
		Description: Walking on water and clinging to walls, at a steady chakra cost
	}
}

